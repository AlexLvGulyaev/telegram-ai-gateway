# =============================================================================
# Telegram AI Gateway - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------

# PostgreSQL user (default: n8n)
POSTGRES_USER=n8n

# PostgreSQL password (CHANGE THIS!)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# PostgreSQL database name (default: n8n)
POSTGRES_DB=n8n

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------

# n8n port (default: 5678)
N8N_PORT=5678

# n8n admin username
N8N_BASIC_AUTH_USER=admin

# n8n admin password (CHANGE THIS!)
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password_here

# Public URL for webhook (optional, required for webhook mode)
# Leave empty for polling mode
WEBHOOK_URL=

# Example for production:
# WEBHOOK_URL=https://your-domain.com

# Timezone (default: UTC)
GENERIC_TIMEZONE=UTC

# Log level: info, warn, error (default: info)
N8N_LOG_LEVEL=info

# Executions mode (default: regular)
# Use 'regular' for standalone n8n, 'queue' for scaling
EXECUTIONS_MODE=regular

# Enable console.log output in Code nodes (n8n 2.x requirement)
# NOTE: This is hardcoded in docker-compose.yml. To change, modify docker-compose.yml directly.
# CODE_ENABLE_STDOUT=true

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------

# Telegram Bot Token (from @BotFather)
# Get your token: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# -----------------------------------------------------------------------------
# GigaChat API Configuration
# -----------------------------------------------------------------------------

# GigaChat API credentials (Base64 encoded: client_id:client_secret)
# Get credentials: https://developers.sber.ru/studio/workspaces
GIGACHAT_AUTH_KEY=your_base64_encoded_credentials_here

# GigaChat scope (default: GIGACHAT_API_PERS)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# -----------------------------------------------------------------------------
# Workflow Configuration
# -----------------------------------------------------------------------------
#
# ВАЖНО: Следующие переменные НЕ ИСПОЛЬЗУЮТСЯ в текущей версии workflow.
# Workflow использует захардкоженные значения в Code node "Configuration".
# Эти переменные оставлены для будущих улучшений.
#
# В текущей версии параметры заданы в workflow:
# - LLM_MODEL = "GigaChat-2-Max"
# - LLM_TEMPERATURE = 0.1
# - LIMIT_TEXT_LENGTH = 12000
# - LIMIT_PROMPT_LENGTH = 5000
# - LIMIT_MESSAGE_LENGTH = 4096
#
# Для изменения этих параметров отредактируйте Code node "Configuration"
# в n8n workflow editor.

# GigaChat model (NOT USED - hardcoded in workflow)
# GIGACHAT_MODEL=GigaChat-2-Max

# GigaChat temperature (NOT USED - hardcoded in workflow)
# GIGACHAT_TEMPERATURE=0.1

# Maximum text length (NOT USED - hardcoded in workflow)
# MAX_TEXT_LENGTH=12000

# Maximum prompt length (NOT USED - hardcoded in workflow)
# MAX_PROMPT_LENGTH=5000

# Maximum message length (NOT USED - hardcoded in workflow)
# MAX_MESSAGE_LENGTH=4096

# System prompt for GigaChat (NOT USED - hardcoded in workflow)
# SYSTEM_PROMPT=

# User prompt template (NOT USED - hardcoded in workflow)
# USER_PROMPT_TEMPLATE=